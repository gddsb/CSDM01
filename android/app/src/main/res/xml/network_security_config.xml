<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <!-- 系统 CA（让浏览器/API 可访问 Let's Encrypt 等正式证书） -->
            <certificates src="system" />
            <!-- APP 自带自签名 CA（信任 43.138.218.55 的自签名证书） -->
            <certificates src="@raw/milkcang_ca" />
            <!-- 用户手动安装的证书（调试用） -->
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
