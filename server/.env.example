# ============================================================================
# 奶粉罐生产管理系统 (Milk Can MES) — 环境变量模板
# ============================================================================
# 使用方法：复制本文件为 .env 后根据实际环境修改
#   cp .env.example .env
#
# 标注说明：
#   [生产必填] — 生产环境必须配置，缺失将拒绝启动（见 src/app.ts）
#   [开发可选] — 开发环境有安全默认值，可直接运行
#   [按需配置] — 视具体场景可选配，不配走代码内默认值
# ============================================================================

# ----------------------------------------------------------------------------
# 基础运行
# ----------------------------------------------------------------------------

# 运行环境标识：development | production
[开发可选] NODE_ENV=development

# 后端监听端口
[开发可选] PORT=3001

# 前端端口（用于开发模式下后端代理到 Vite）
[按需配置] FRONTEND_PORT=5173


# ----------------------------------------------------------------------------
# 安全：JWT 密钥
# ----------------------------------------------------------------------------

# JWT 签名密钥 —— 生产环境强制要求 ≥16 位随机字符串
# 生成方式（任选其一）：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#   openssl rand -base64 32
[生产必填] JWT_SECRET=change-me-to-a-strong-random-key-at-least-32-bytes

# Access Token 有效期
[按需配置] JWT_EXPIRES_IN=2h

# Refresh Token 有效期
[按需配置] JWT_REFRESH_EXPIRES_IN=7d


# ----------------------------------------------------------------------------
# 数据库
# ----------------------------------------------------------------------------

# 数据库类型：mysql | sqlite
#   开发环境默认 mysql；切换到 sqlite 可实现零配置启动
#   ⚠️ 生产环境禁止使用 sqlite，强制要求 mysql
[开发可选] DB_DIALECT=mysql

# MySQL 连接参数（DB_DIALECT=mysql 时生效）
[生产必填] DB_HOST=127.0.0.1
[按需配置] DB_PORT=3306
[生产必填] DB_USER=root
[生产必填] DB_PASSWORD=your-db-password
[生产必填] DB_NAME=milk_can_mes

# SQLite 文件路径（DB_DIALECT=sqlite 时生效）
[按需配置] DB_STORAGE=./data/milk_can_mes.sqlite

# Sequelize 慢 SQL 阈值（毫秒），日志中打印 [SLOW SQL xxxms]
[按需配置] SLOW_SQL_MS=800

# 是否开启 SQL 查询日志（true/false）
[按需配置] DB_LOGGING=false


# ----------------------------------------------------------------------------
# 安全：CORS & 限流
# ----------------------------------------------------------------------------

# CORS 允许来源（生产环境生效，逗号分隔）
# 不配置则允许所有来源（开发模式等价）
[按需配置] CORS_ORIGIN=

# 登录接口限流：时间窗口（毫秒）+ 最大尝试次数
[按需配置] LOGIN_RATE_WINDOW_MS=60000
[按需配置] LOGIN_RATE_LIMIT=30

# 通用 API 限流（每分钟每 IP 最大请求数）
[按需配置] API_RATE_LIMIT=1000


# ----------------------------------------------------------------------------
# 日志
# ----------------------------------------------------------------------------

# 日志级别：debug | info | warn | error
[按需配置] LOG_LEVEL=info

# 是否开启 SQL Profiler（true/false）—— 输出详细 SQL 执行链路
[按需配置] SQL_PROFILER=0


# ----------------------------------------------------------------------------
# 超时阈值
# ----------------------------------------------------------------------------

# API 接口慢响应阈值（毫秒），performance 中间件打点用
[按需配置] SLOW_API_MS=1000

# SQL 慢查询阈值（毫秒），performance 中间件打点用
[按需配置] SLOW_SQL_MS=500


# ----------------------------------------------------------------------------
# 数据目录 & 备份
# ----------------------------------------------------------------------------

# 数据库备份输出目录
[按需配置] BACKUP_DIR=./data/backups

# 系统日志文件目录
[按需配置] LOG_DIR=./data/backups


# ----------------------------------------------------------------------------
# U9 ERP 集成（按需配置）
# ----------------------------------------------------------------------------
# 注意：当前代码中存在默认值回退，这里仅作配置入口。
# 如果希望完全去掉回退值，需额外改动 u9Service.ts / u9Login.ts（不在本轮改进范围）。

# U9 服务地址
[按需配置] U9_BASE_URL=http://your-u9-server/U9/mvc
[按需配置] U9_ERP_URL=http://your-u9-server/U9/erp/display.aspx

# U9 企业信息
[按需配置] U9_ENTERPRISE_ID=01
[按需配置] U9_ENTERPRISE_NAME=your-company-name

# U9 登录账号
[按需配置] U9_USERNAME=
[按需配置] U9_PASSWORD=
[按需配置] U9_ORG_CODE=

# U9 AES 密钥（用于密码加密传输）
[按需配置] U9_AES_KEY=


# ----------------------------------------------------------------------------
# 环境监测集成（按需配置）
# ----------------------------------------------------------------------------

# 0531yun 物联网平台登录（环境监测采集用）
[按需配置] ENV_LOGIN_NAME=
[按需配置] ENV_PASSWORD=


# ----------------------------------------------------------------------------
# 任务参数加密
# ----------------------------------------------------------------------------

# 任务参数 AES 加密密钥（与 U9_AES_KEY 默认值相同，生产可独立配置）
[按需配置] TASK_PARAM_KEY=
