{
  "name": "milk-can-mes",
  "version": "1.0.1.730",
  "description": "奶粉罐生产管理系统",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 5173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 9999",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "cap:sync": "cap sync",
    "cap:sync:android": "cap sync android",
    "cap:sync:ios": "cap sync ios",
    "build:android": "cross-env VITE_API_BASE_URL=http://43.138.218.55/api npm run build && cap sync android",
    "build:android:dev": "npm run build && cap sync android",
    "build:ios": "cross-env VITE_API_BASE_URL=http://43.138.218.55/api npm run build && cap sync ios"
  },
  "dependencies": {
    "@ant-design/icons": "^5.5.1",
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@tanstack/react-query": "^5.101.4",
    "antd": "^5.21.0",
    "antd-mobile": "^5.42.3",
    "antd-mobile-icons": "^0.3.0",
    "axios": "^1.18.1",
    "dayjs": "^1.11.13",
    "echarts": "^6.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^10.1.0",
    "docx": "^9.7.1",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "html-docx-js-typescript": "^0.1.5",
    "markdown-it": "^14.3.0",
    "prettier": "^3.9.6",
    "typescript": "~5.6.0",
    "vite": "^5.4.8",
    "vite-plugin-pwa": "^1.3.0"
  }
}
